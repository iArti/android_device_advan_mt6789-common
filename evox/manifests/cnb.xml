  <project path="vendor/advan/T812" name="android_vendor_advan_T812" remote="diggieman"
           revision="03ae84884326aff503d8648ad5fb1404cd5cdf8e" upstream="lineage-24.0" dest-branch="lineage-24.0" />
</manifest>
