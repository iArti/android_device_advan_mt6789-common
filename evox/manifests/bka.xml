  <project path="device/mediatek/sepolicy_vndr" name="android_device_mediatek_sepolicy_vndr" remote="millennium"
           revision="1136b3f2fd3079b2b3a44db457ae9ed7bca43fe2" upstream="sixteen-qpr2-rebase" dest-branch="sixteen-qpr2-rebase" />

  <!-- Common MediaTek IMS -->
