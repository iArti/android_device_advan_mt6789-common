           revision="e9cab87f806ab010346dd61cab3dc4fd6051aa59" upstream="android-16-qpr2" dest-branch="android-16-qpr2" />

  <!-- T812 trees (stock GKI 5.10 kernel is prebuilt in T812-kernel) -->
